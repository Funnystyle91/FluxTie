                android:pivotX="60.09"
                android:pivotY="58.36">
                <path
                    android:name="waterdrop_deep"
                    android:fillColor="#1565C0"
                    android:fillAlpha="1.0"
                    android:pathData="M 60.09,39.66 A 18.70,18.70 0 1,1 60.08,39.66 Z" />
            </group>

