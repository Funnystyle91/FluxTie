<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="160dp"
            android:height="160dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- 1. 物理底圆：160dp 满态纯净圆锚定，零跳闪 -->
            <group
                android:name="circle_group"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:name="bg_circle"
                    android:fillColor="#F4F7FC"
                    android:pathData="M 54,0 A 54,54 0 1,0 54,108 A 54,54 0 1,0 54,0 Z" />
            </group>

            <!-- 2. 冰川天蓝液态水滴 (#42A5F5) -->
            <group
                android:name="waterdrop_sky_group"
                android:pivotX="45.6"
                android:pivotY="47.7">
                <path
                    android:name="waterdrop_sky"
                    android:fillColor="#42A5F5"
                    android:fillAlpha="0.92"
                    android:pathData="M 45.6,21.2 A 26.5,26.5 0 1,1 45.59,21.2 Z" />
            </group>

            <!-- 3. 贴吧经典深蓝水滴 (#1565C0) -->
            <group
                android:name="waterdrop_deep_group"
                android:pivotX="62.8"
                android:pivotY="60.3">
                <path
                    android:name="waterdrop_deep"
                    android:fillColor="#1565C0"
                    android:fillAlpha="1.0"
                    android:pathData="M 62.8,33.3 A 27.0,27.0 0 1,1 62.79,33.3 Z" />
            </group>

            <!-- 4. 官方真身纯白「贴」字 (曲率连续平滑) -->
            <group
                android:name="tie_char_group"
                android:pivotX="54"
                android:pivotY="54">
                <path
                    android:name="tie_char"
                    android:fillColor="#FFFFFF"
                    android:fillType="evenOdd"
                    android:pathData="M 38.37 37.70 Q 37.57 37.71 37.57 38.50 L 37.46 66.16 Q 37.45 66.35 37.35 66.50 L 37.32 66.54 Q 37.22 66.69 37.22 66.88 L 37.22 67.82 Q 37.22 68.00 37.11 68.16 L 37.08 68.20 Q 36.98 68.34 36.95 68.51 L 36.73 69.70 L 36.01 71.15 L 33.70 73.70 Q 33.61 73.80 33.50 73.86 L 31.41 75.02 L 30.07 75.47 Q 29.95 75.51 29.82 75.51 L 29.29 75.51 Q 29.11 75.51 28.96 75.62 L 28.92 75.64 Q 28.77 75.75 28.58 75.76 L 28.23 75.79 Q 27.79 75.83 27.79 76.27 L 27.78 79.08 Q 27.78 79.87 28.56 79.88 L 33.03 79.98 Q 33.26 79.99 33.46 79.87 L 33.86 79.63 Q 34.03 79.53 34.22 79.51 L 34.30 79.51 Q 34.49 79.50 34.65 79.41 L 36.17 78.54 L 36.90 77.80 Q 37.03 77.68 37.19 77.63 L 37.23 77.62 Q 37.40 77.56 37.52 77.44 L 39.15 75.81 Q 39.27 75.69 39.32 75.52 L 39.34 75.48 Q 39.39 75.32 39.53 75.22 L 39.80 75.02 Q 40.13 74.79 40.41 75.08 L 42.94 77.80 L 46.08 79.73 L 46.71 79.94 Q 46.84 79.99 46.97 79.98 L 51.20 79.97 Q 51.98 79.97 51.99 79.19 L 52.06 76.17 Q 52.06 75.83 51.73 75.79 L 51.51 75.77 Q 51.33 75.75 51.17 75.64 L 51.14 75.62 Q 50.99 75.51 50.80 75.51 L 50.27 75.51 Q 50.14 75.51 50.02 75.47 L 48.68 75.02 L 46.48 73.80 L 44.59 71.90 L 43.36 69.70 L 42.92 68.36 Q 42.88 68.24 42.88 68.11 L 42.88 67.59 Q 42.88 67.40 42.77 67.25 L 42.75 67.21 Q 42.64 67.06 42.64 66.87 L 42.64 37.96 Q 42.64 37.85 42.57 37.78 L 42.55 37.76 Q 42.48 37.69 42.37 37.69 Z M 31.35 29.95 L 29.80 31.51 Q 29.71 31.59 29.66 31.69 L 28.33 34.13 Q 28.24 34.31 28.24 34.51 L 28.24 34.73 Q 28.24 34.91 28.13 35.07 L 28.11 35.10 Q 28.00 35.25 28.00 35.44 L 28.00 36.38 Q 28.00 36.57 27.89 36.72 L 27.87 36.76 Q 27.76 36.91 27.76 37.09 L 27.79 66.11 Q 27.79 66.90 28.58 66.91 L 32.92 66.98 Q 33.02 66.99 33.10 66.91 L 33.11 66.90 Q 33.19 66.82 33.19 66.72 L 33.19 36.59 Q 33.19 36.44 33.24 36.29 L 33.63 35.33 Q 33.69 35.18 33.80 35.06 L 34.57 34.28 Q 34.66 34.19 34.78 34.13 L 35.56 33.74 Q 35.73 33.66 35.91 33.66 L 46.62 33.66 Q 46.73 33.66 46.81 33.74 L 46.83 33.76 Q 46.91 33.84 46.91 33.95 L 46.9