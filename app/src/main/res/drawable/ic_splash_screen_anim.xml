            </group>

            <!-- 5. 右上角论坛加精琥珀微光星石 -->
            <group
                android:name="gemstone_group"
                android:pivotX="79.5"
                android:pivotY="25.5">
                <path
                    android:name="gem_outer"
                    android:fillColor="#FFB300"
                    android:pathData="M 79.5,22.5 A 3.0,3.0 0 1,1 79.49,22.5 Z" />
                <path
                    android:name="gem_inner"
                    android:fillColor="#FFFFFF"
                    android:pathData="M 79.5,24.0 A 1.5,1.5 0 1,1 79.49,24.0 Z" />
            </group>

            <!-- 计时哨兵 (1000ms 完整周期) -->
            <group android:name="time_marker" />
        </vector>
    </aapt:attr>

    <!-- 1. 冰川天蓝水滴弹性碰撞展开 (0ms ~ 560ms) -->
    <target android:name="waterdrop_sky_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.45"
                    android:valueTo="1.06"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="420"
                    android:duration="140"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="1.06"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.45"
                    android:valueTo="1.06"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="420"
                    android:duration="140"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="1.06"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="waterdrop_sky">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="240"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="0.92"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- 2. 贴吧深蓝水滴交融展开 (80ms ~ 620ms) -->
    <target android:name="waterdrop_deep_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="80"
                    android:duration="420"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.45"
                    android:valueTo="1.06"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="500"
                    android:duration="120"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="1.06"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="80"
                    android:duration="420"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.45"
                    android:valueTo="1.06"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="500"
                    android:duration="120"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="1.06"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="waterdrop_deep">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="80"
                    android:duration="220"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- 3. 官方真身贴字流光弹射浮现 (180ms ~ 720ms) -->
    <target android:name="tie_char_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="180"
                    android:duration="380"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.65"
                    android:valueTo="1.05"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="560"
                    android:duration="160"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="1.05"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="180"
                    android:duration="380"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.65"
                    android:valueTo="1.05"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="560"
                    android:duration="160"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="1.05"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="180"
                    android:duration="400"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="translateY"
                    android:valueFrom="8.0"
                    android:valueTo="0.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="tie_char">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="180"
                    android:duration="240"
                    android:interpolator="@android:interpolator/linear"
                    android:propertyName="fillAlpha"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- 4. 右上角论坛加精琥珀星石脉冲绽放 (460ms ~ 780ms) -->
    <target android:name="gemstone_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="460"
                    android:duration="220"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="0.0"
                    android:valueTo="1.3"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="680"
                    android:duration="100"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:valueFrom="1.3"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="460"
                    android:duration="220"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="0.0"
                    android:valueTo="1.3"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="680"
                    android:duration="100"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleY"
                    android:valueFrom="1.3"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <!-- 5. 1000ms 计时哨兵，确保定格 -->
    <target android:name="time_marker">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="1000"
                    android:propertyName="translateX"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
